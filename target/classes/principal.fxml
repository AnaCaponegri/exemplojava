<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="FirstFx.controller.PrincipalController"
    stylesheets="@style.css"
    styleClass="fundo-app">
    <top>
        <HBox alignment="CENTER_LEFT"
            spacing="16"
            styleClass="barra-topo">
            <padding>
                <Insets top="18"
                    right="24"
                    bottom="18"
                    left="24" />
            </padding>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Painel principal"
                    styleClass="titulo-claro" />
                <Label fx:id="labelBoasVindas"
                    text="Bem-vindo"
                    styleClass="texto-claro" />
            </VBox>
            <Button text="Sair"
                styleClass="botao-perigo"
                onAction="#sair" />
        </HBox>
    </top>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24"
                    right="24"
                    bottom="24"
                    left="24" />
            </padding>
            <HBox alignment="CENTER_LEFT"
                spacing="10">
                <Label text="Usuários cadastrados"
                    styleClass="titulo-secao" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Atualizar"
                    styleClass="botao-secundario"
                    onAction="#atualizarTabela" />
                <Button text="Cadastrar usuário"
                    styleClass="botao-primario"
                    onAction="#abrirCadastro" />
            </HBox>
            <TableView fx:id="tabelaUsuarios"
                VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Nenhum usuário cadastrado." />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colunaId"
                        text="ID"
                        prefWidth="55" />
                    <TableColumn fx:id="colunaNome"
                        text="Nome"
                        prefWidth="190" />
                    <TableColumn fx:id="colunaLogin"
                        text="Login"
                        prefWidth="130" />
                    <TableColumn fx:id="colunaEmail"
                        text="E-mail"
                        prefWidth="230" />
                    <TableColumn fx:id="colunaPerfil"
                        text="Perfil"
                        prefWidth="120" />
                    <TableColumn fx:id="colunaAtivo"
                        text="Ativo"
                        prefWidth="80" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>